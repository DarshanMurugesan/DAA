import java.util.*;
public class SubsetBacktracking {
    static void generateSubsets(int[] set, int index, List<Integer> subset) {
        if (index == set.length) {
    System.out.println(subset);
            return;
        }
      subset.add(set[index]);
        generateSubsets(set, index + 1, subset);
       subset.remove(subset.size() - 1);
        generateSubsets(set, index + 1, subset);
    }
 public static void main(String[] args) {
   Scanner sc = new Scanner(System.in);
   System.out.print("Enter number of elements: ");
 int n = sc.nextInt();         
int[] set = new int[n];
System.out.println("Enter elements:");
 for (int i = 0; i < n; i++) {
 set[i] = sc.nextInt();
        } 
System.out.println("Subsets are:");        generateSubsets(set, 0, new ArrayList<>());
     sc.close();
    }
}